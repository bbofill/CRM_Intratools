cat << 'EOF' > .gitignore
# Binarios y ejecutables compilados
*.bin
crmintratools.bin
goevoko
goEvoko

# Estado interno, uploads y copias de seguridad
Data/
Backups/
Uploads/
*.sqlite-wal
*.sqlite-shm

# Certificados locales SSL/TLS y claves privadas
SSLCerts/
GpgKeys/
GPGKeys/

# Credenciales y configuración sensible
Config/
*.env
.env
!.env.example

# Logs y auditoría
*.log

# Documentación compilada y librerías externas pesadas
site/
GUI/assets/js/pdfjs-dist/

# Entornos virtuales, dependencias y cachés
vendor/
venv/
__pycache__/
*.py[cod]
.DS_Store
.vscode/
